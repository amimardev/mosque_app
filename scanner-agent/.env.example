# Generate a long random value and enter it in the mosque app scan dialog.
SCANNER_AGENT_TOKEN=replace-with-a-random-secret-at-least-32-characters
# Exact website origins allowed to call this local service.
MOSQUE_APP_ORIGINS=https://your-mosque-app.vercel.app,http://localhost:3000,http://127.0.0.1:3000
# Windows NAPS2 CLI executable. Change if installed in another location.
NAPS2_CONSOLE_PATH=C:\Program Files\NAPS2\NAPS2.Console.exe
SCANNER_AGENT_PORT=8765
