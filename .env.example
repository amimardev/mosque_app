# Gemini AI (Required for student document scanning & parsing)
GEMINI_API_KEY=""
# Optional: Starting model override. Defaults to gemini-3.8-flash with automatic
# fallback cascade to gemini-3.6-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite.
# GEMINI_MODEL="gemini-3.8-flash"

# Database (Neon PostgreSQL connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Object Storage (S3-compatible storage for profile pictures & avatars)
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
AWS_S3_BUCKET="assets"

# Application URL (Used for links and redirects)
APP_URL="https://mosque-app-pi.vercel.app"

# OneSignal Push Notifications
ONESIGNAL_APP_ID=""
ONESIGNAL_REST_API_KEY=""

# Scanner Agent URL (Optional override; defaults to http://127.0.0.1:8765)
# VITE_SCANNER_AGENT_URL="http://127.0.0.1:8765"
